# ── Obrigatórias ───────────────────────────────────────────────────────────
# Supabase (schema `atalaia`). Sem estas duas, o app usa .data/cloud.json (só dev).
SUPABASE_URL=https://SEU-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Assina sessões e cifra keys/proxies. Gere com: openssl rand -hex 32
APP_SECRET=

# ── Administração ──────────────────────────────────────────────────────────
# Troca a key mestra padrão (access-6xy-67).
ADMIN_KEY=

# ── Login com Discord ──────────────────────────────────────────────────────
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Opcional; por padrão usa https://<host>/api/auth/discord/callback
# DISCORD_REDIRECT_URI=

# ── Motor 24/7 (opcional) ──────────────────────────────────────────────────
# Token de automação auto_... do PhanomCloud
PHANOM_TOKEN=

# ── Legado v1.0 (opcional) ─────────────────────────────────────────────────
# Senha antiga do console; a v1.1 usa Discord + key.
# APP_PASSWORD=
CRON_SECRET=

# Força o driver de arquivo (desenvolvimento offline)
# ATALAIA_DB_MODE=local
