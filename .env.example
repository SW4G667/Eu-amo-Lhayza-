# Acesso ao painel (obrigatório em produção)
APP_PASSWORD=troque-esta-senha

# Chave usada para assinar sessão e cifrar tokens/proxies (AES-256-GCM).
# Gere com: openssl rand -hex 32
APP_SECRET=

# Opcional: permite disparar /api/cron com ?key=... ou Authorization: Bearer ...
CRON_SECRET=

# Opcional: persistência externa (funciona com Vercel KV ou Upstash Redis REST)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# ou
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
